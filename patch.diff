   local file
   for file in "$(secrets_file)" "$ROOT_DIR/config.local.example"; do
     [[ -f "$file" ]] || continue
-    grep -Eo '^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=' "$file" 2>/dev/null \
