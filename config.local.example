# fail2ban-scripts/config.local.example — template for host-specific configuration
# Copy this file to config.local (gitignored) and customize the values below.
#
#   cp config.local.example config.local && chmod 600 config.local
#
# This file contains ALL machine-specific settings that must NOT be committed
# to GitHub:
#   - Telegram bot tokens and chat IDs
#   - Fail2Ban-UI callback secret
#   - ALLOWED_DOMAINS / ALLOWED_HOSTS for ignorehost
#   - Auto-update toggle (AUTO_UPDATE_ENABLED)
#
# The source files read this file at runtime via deploy.sh / redact.sh /
# version_check.sh / ignorehost.sh. There is no separate secrets file.
#
# Required: this file MUST be owned by root and have mode 0600.

# ==============================
# TELEGRAM CREDENTIALS
# ==============================
# Bot used by scripts/fail2ban-telegram.sh (ban/unban notifications)
TELEGRAM_BOT_TOKEN_NOTIFY=__TELEGRAM_BOT_TOKEN_NOTIFY__
# Chat ID used by scripts/fail2ban-telegram.sh and fail2ban-telegram_old.sh
TELEGRAM_CHAT_ID_NOTIFY=__TELEGRAM_CHAT_ID_NOTIFY__
# Bot used by scripts/ignorehost.sh, ignorehost_old.sh and
# (for the token) fail2ban-telegram_old.sh
TELEGRAM_BOT_TOKEN_IGNOREHOST=__TELEGRAM_BOT_TOKEN_IGNOREHOST__
# Chat ID used by scripts/ignorehost.sh and ignorehost_old.sh
TELEGRAM_CHAT_ID_IGNOREHOST=__TELEGRAM_CHAT_ID_IGNOREHOST__

# ==============================
# FAIL2BAN-UI CALLBACK SECRET
# ==============================
# Secret for action.d/ui-custom-action.conf (callback on 127.0.0.1:8083)
FAIL2BAN_UI_CALLBACK_SECRET=__FAIL2BAN_UI_CALLBACK_SECRET__

# ==============================
# AUTO-UPDATE SETTINGS
# ==============================
# Enable/disable automatic script updates from GitHub
# Set to true to enable, false to disable
AUTO_UPDATE_ENABLED=true

# ==============================
# ALLOWED DOMAINS FOR IGNOREHOST
# ==============================
# Domains whose IP ranges are whitelisted for automatic ignore
# Replace with your own domains
ALLOWED_DOMAINS = [
    "your-domain.duckdns.org",
    "your-domain.mywire.org",
    "another-domain.duckdns.org",
    "another-domain.mywire.org"
]

# ==============================
# ALLOWED HOSTS FOR IGNOREHOST
# ==============================
# Host providers (network blocks) whitelisted regardless of domain
# Replace with your own provider domains
ALLOWED_HOSTS = [
    ".static.your-isp.it",
    ".retail.your-fiber.it",
    ".pool-bba.your-provider.it"
]