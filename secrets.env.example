# secrets.env.example — copia questo file in `secrets.env` (gitignored) e compila i valori reali.
#
#   cp secrets.env.example secrets.env && chmod 600 secrets.env
#
# I valori reali NON vivono mai nel repository: i file sorgente contengono
# placeholder (__NAME__) che scripts/deploy.sh sostituisce solo quando prepara
# i file destinati alla directory dati di fail2ban.

# Bot Telegram usato da scripts/fail2ban-telegram.sh (notifiche ban/unban)
TELEGRAM_BOT_TOKEN_NOTIFY=__TELEGRAM_BOT_TOKEN_NOTIFY__

# Chat ID usato da scripts/fail2ban-telegram.sh e fail2ban-telegram_old.sh
TELEGRAM_CHAT_ID_NOTIFY=__TELEGRAM_CHAT_ID_NOTIFY__

# Bot Telegram usato da scripts/ignorehost.sh, ignorehost_old.sh e
# (per il token) fail2ban-telegram_old.sh
TELEGRAM_BOT_TOKEN_IGNOREHOST=__TELEGRAM_BOT_TOKEN_IGNOREHOST__

# Chat ID usato da scripts/ignorehost.sh e ignorehost_old.sh
TELEGRAM_CHAT_ID_IGNOREHOST=__TELEGRAM_CHAT_ID_IGNOREHOST__

# Segreto di callback della Fail2Ban-UI (action.d/ui-custom-action.conf)
FAIL2BAN_UI_CALLBACK_SECRET=__FAIL2BAN_UI_CALLBACK_SECRET__
